# Local provider used in the reported experiment.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SEED=42
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_KEEP_ALIVE=30m

# Ontology service defaults.
ONTOLOGY_SYSTEM=ontogenia
EXTERNAL_ONTOLOGY_SERVICE_URL=http://127.0.0.1:8020/generate_ontology
ONTOLOGY_DATASET_DIR=datasets/ontology_generation/normalized
ONTOLOGY_PROJECT2_OUTPUT_DIR=outputs/project2
ONTOLOGY_EXTERNAL_TIMEOUT=1800
LOG_LEVEL=INFO

# The reported run did not use external HermiT or OOPS services.
HERMIT_AUTO=false
OOPS_API_URL=
