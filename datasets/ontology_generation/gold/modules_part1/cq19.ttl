###  http://w3id.org/CEON/ontology/product/Product
<http://w3id.org/CEON/ontology/product/Product> rdf:type owl:Class ;
                                                rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty <http://w3id.org/CEON/ontology/product/hasProductComponent> ;
                                                                                         owl:someValuesFrom <http://w3id.org/CEON/ontology/product/ProductComponent>
                                                                                       ]
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty <http://w3id.org/CEON/ontology/product/hasProductComponent> ;
                                                                                         owl:allValuesFrom <http://w3id.org/CEON/ontology/product/ProductComponent>
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                                rdfs:comment "A product is a physical object put into a market for sale. The product can be a thing that grows naturally or produced through some chemical or manufacturing processes."@en ;
                                                rdfs:label "Product"@en .


###  http://w3id.org/CEON/ontology/product/ProductComponent
<http://w3id.org/CEON/ontology/product/ProductComponent> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Constituent> ;
                                                         rdfs:comment "A product component is a part of a product."@en ;
                                                         rdfs:label "ProductComponent"@en .


###  http://w3id.org/CEON/ontology/resourceODP/Constituent
<http://w3id.org/CEON/ontology/resourceODP/Constituent> rdf:type owl:Class ;
                                                        rdfs:comment "A constituent is a component of object."@en ;
                                                        rdfs:label "Constituent"@en ;
                                                        rdfs:seeAlso "http://emmo.info/emmo#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186" .


###  http://w3id.org/CEON/ontology/resourceODP/Matter
<http://w3id.org/CEON/ontology/resourceODP/Matter> rdf:type owl:Class ;
                                                   rdfs:comment "A matter is a physical substance."@en ;
                                                   rdfs:label "Matter"@en ;
