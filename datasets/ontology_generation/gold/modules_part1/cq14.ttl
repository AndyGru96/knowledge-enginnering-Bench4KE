     xml:base="http://www.semanticweb.org/mohsa33/materialresourceODP"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/mohsa33/materialresourceODP">
        <terms:contributor>Eva Blomqvist</terms:contributor>
        <terms:contributor>Mikael Lindecrantz</terms:contributor>
        <terms:contributor>Robin Keskisärkkä</terms:contributor>
        <terms:created>2023-03-16</terms:created>
        <terms:creator>Huanyu Li</terms:creator>
        <terms:description>A core ODP of the CEON ontology network defining aspects of the resource concept.</terms:description>
        <terms:description>The Material module of CEON (Circular Economy Ontology Network).</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:license>https://github.com/LiUSemWeb/CEON/blob/master/LICENSE</terms:license>
        <terms:title>Circular Economy Ontology Network (CEON) - Material Module</terms:title>
        <terms:title>Circular Economy Ontology Network (CEON) - Resource ODP</terms:title>
        <vann:preferredNamespacePrefix>material</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>resourceODP</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/CEON/ontology/material/</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>http://w3id.org/CEON/ontology/resourceODP/</vann:preferredNamespaceUri>
        <cpannotationschema:coversRequirements>Covers the following requirements from Onto-DESIDE D3.1: CVN-Resource-1,3, CVN-Composition-1,2, CVN-ResrouceType-4, C7-3, E2-2, E4-6, E5-1, E6-3, T3-1.</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements>In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: CVN-Resource-2, CVN-ResourceType-4, C3-3, E1-3, E2-4, E5-2, T1-1, T10-2.</cpannotationschema:coversRequirements>
        <rdfs:seeAlso rdf:resource="https://github.com/LiUSemWeb/CEON"/>
        <owl:versionInfo>0.1</owl:versionInfo>
    </owl:Ontology>
    


