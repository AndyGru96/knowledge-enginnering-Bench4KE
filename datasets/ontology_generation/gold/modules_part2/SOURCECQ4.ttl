<https://w3id.org/polifonia/ontology/core/> rdf:type owl:Ontology ;
                                             dc:creator "Andrea Poltronieri"@en ,
                                                        "Jacopo de Berardinis"@en ,
                                                        "Nicolas Lazzari"@en ,
                                                        "Valentina Carriero"@en ,
                                                        "Valentina Presutti"@en ;
                                             dc:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
                                             terms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
                                             rdfs:comment "The Core ontology models general-purpose concepts, relationships and ontology design patterns (e.g. place, time, classification, situation), which are orthogonal to the whole Polifonia ontology network. Indeed, it is imported and possibly specialised by the other ontology modules of the network."@en ;
                                             rdfs:label "Core Ontology"@en ,
                                                        "Core ontology (Polifonia ontology network)"@en ;
                                             owl:priorVersion "1.0"@en .

