<https://w3id.org/polifonia/ontology/instrument/hasBuilder> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <https://w3id.org/polifonia/ontology/instrument/InstrumentRealization> ;
                                                            rdfs:range core:Agent ;
                                                            rdfs:comment "The relation between an instrument realization and its builder."@en ;
                                                            rdfs:label "has builder"@en .


